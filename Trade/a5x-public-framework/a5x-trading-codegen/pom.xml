<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>br.com.a5x.trd</groupId>
    <artifactId>a5x-public-framework</artifactId>
    <version>2.0.0</version>
  </parent>
  <artifactId>a5x-trading-codegen</artifactId>

  <build>
    <plugins>
      <!--
        The generator uses only the JDK, so the jar runs on its own with java -jar
        (see "Running the generator as a jar" in the README).
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>br.com.a5x.trd.codegen.A5XCodeGenApp</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
