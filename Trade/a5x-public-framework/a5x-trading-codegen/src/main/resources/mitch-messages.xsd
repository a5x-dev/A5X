<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://a5x.com.br/mitch"
           xmlns:mitch="http://a5x.com.br/mitch"
           elementFormDefault="qualified">

    <xs:element name="messages">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="types" type="mitch:TypesType" minOccurs="0"/>
                <xs:element name="header" type="mitch:HeaderType" minOccurs="0" maxOccurs="unbounded"/>
                <xs:element name="message" type="mitch:MessageType" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!--
        Transport framing that wraps the payload messages. MITCH prefixes every UDP packet
        with a unit header; describing it here is what lets a consumer decode a capture from
        this file alone, without cross-referencing the gateway documentation.
    -->
    <xs:complexType name="HeaderType">
        <xs:sequence>
            <xs:element name="field" type="mitch:FieldType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="description" type="xs:string"/>
    </xs:complexType>

    <!--
        Declarative catalog of the wire data types this protocol uses. The generators map the
        DataType enumeration below to language specific types; this block documents the wire
        contract those mappings have to honour (width, byte order, encoding, decimal scaling).
    -->
    <xs:complexType name="TypesType">
        <xs:sequence>
            <xs:element name="type" type="mitch:TypeType" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="byteOrder" type="mitch:ByteOrder"/>
    </xs:complexType>

    <xs:complexType name="TypeType">
        <xs:attribute name="name" type="mitch:DataType" use="required"/>
        <xs:attribute name="wireSize" type="mitch:WireSize" use="required"/>
        <xs:attribute name="encoding" type="xs:string" use="required"/>
        <xs:attribute name="impliedDecimals" type="xs:nonNegativeInteger"/>
        <xs:attribute name="padding" type="mitch:Padding"/>
        <!-- Literal layout of an ASCII-encoded type, for example YYYYMMDD or HH:MM:SS. -->
        <xs:attribute name="format" type="xs:string"/>
        <!--
            The type each generator emits. For the shared core these values are identical to
            the ones in native-messages.xml, so a given wire type surfaces as the same language
            type in both SDKs.
        -->
        <xs:attribute name="javaType" type="xs:string"/>
        <xs:attribute name="csharpType" type="xs:string"/>
        <xs:attribute name="cppType" type="xs:string"/>
        <xs:attribute name="description" type="xs:string"/>
    </xs:complexType>

    <!-- Either a fixed octet count or "variable", in which case each field carries a length. -->
    <xs:simpleType name="WireSize">
        <xs:union>
            <xs:simpleType>
                <xs:restriction base="xs:positiveInteger"/>
            </xs:simpleType>
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:enumeration value="variable"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:union>
    </xs:simpleType>

    <xs:simpleType name="Padding">
        <xs:restriction base="xs:string">
            <xs:enumeration value="null-terminated"/>
            <xs:enumeration value="space-padded"/>
            <xs:enumeration value="none"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="ByteOrder">
        <xs:restriction base="xs:string">
            <xs:enumeration value="little-endian"/>
            <xs:enumeration value="big-endian"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="MessageType">
        <xs:sequence>
            <!-- minOccurs="0": some administrative messages carry no body, e.g. Logout Request. -->
            <xs:element name="field" type="mitch:FieldType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="messageType" type="xs:string" use="required"/>
        <xs:attribute name="description" type="xs:string"/>
    </xs:complexType>

    <xs:complexType name="FieldType">
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="type" type="mitch:DataType" use="required"/>
        <xs:attribute name="length" type="xs:int"/>
        <xs:attribute name="decimals" type="xs:int"/>
        <xs:attribute name="description" type="xs:string"/>
    </xs:complexType>

    <!--
        Ordered to match the shared core in native-messages.xsd, followed by the MITCH only
        types. char, string and int64 were removed: they appear in no A5X specification, no
        field uses them, and string duplicated alpha. The MITCH generators still handle them,
        so re-adding an enumeration here is enough should a future message need one.
    -->
    <xs:simpleType name="DataType">
        <xs:restriction base="xs:string">
            <!-- Shared core: keep in sync with native-messages.xsd. -->
            <xs:enumeration value="alpha"/>
            <xs:enumeration value="byte"/>
            <xs:enumeration value="bitfield"/>
            <xs:enumeration value="int32"/>
            <xs:enumeration value="uint8"/>
            <xs:enumeration value="uint16"/>
            <xs:enumeration value="uint32"/>
            <xs:enumeration value="uint64"/>
            <xs:enumeration value="price4"/>
            <xs:enumeration value="price8"/>
            <!-- MITCH only: ASCII temporal types plus bytearray for reserved fields. -->
            <xs:enumeration value="bytearray"/>
            <xs:enumeration value="date"/>
            <xs:enumeration value="time"/>
            <xs:enumeration value="extendedtime"/>
            <xs:enumeration value="datetime"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>
