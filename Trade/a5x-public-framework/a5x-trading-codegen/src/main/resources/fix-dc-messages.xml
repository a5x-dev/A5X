<?xml version="1.0" encoding="UTF-8"?>
<!--
    A5X Drop Copy FIX Gateway - QuickFIX data dictionary
    ====================================================

    Source : https://portal-tecnico.a5x.com.br/pt-br/trading/drop-copy-fix
             "Drop Copy Fix Gateway | Portal Tecnico", snapshot captured 2026-08-04.

    Base protocol: FIX 4.4. Message level encryption is not supported.

    Usage (QuickFIX / QuickFIX-J):
        [SESSION]
        BeginString=FIX.4.4
        DataDictionary=fix-dc-messages.xml

    Scope
    =====
    Drop Copy is a receive oriented service. The only application message a client sends is
    Order Mass Status Request (AF); everything else is server generated. The service cannot be
    used to submit orders or to receive market data.

    Differences from the OrderEntry dictionary (fix-oe-messages.xml)
    ===============================================================
    * Header adds OnBehalfOfCompID (115). The gateway stamps it on server initiated
      application messages with the CompID of the connection that originated the order being
      drop copied.
    * Adds Order Mass Status Request (AF).
    * Drops the order entry, cross, mass cancel and quote submission messages.
    * NoPartyIDs (453) is optional on Execution Report, Mass Quote Acknowledgement and
      Quote Status Report, where OrderEntry marks it required.
    * Adds RFQID (30006) on Quote Status Report.

    Notes on fidelity
    =================
    1. The <header> block lists exactly the fields the specification documents. The standard
       FIX 4.4 header carries further optional fields; add them if your engine emits them.
    2. A5X reuses tags introduced after FIX 4.4 (ApplVerID 1128, SessionStatus 1409,
       NewPassword 925, ApplID 1180, DisplayQty 1138, DisplayMethod 1084,
       PreTradeAnonymity 1091, AggressorIndicator 1057, QuoteMsgID 1166,
       QuoteEntryStatus 1167, Volatility 1188, MarketSegmentID 1300). They are declared below.
    3. Exchange defined custom tags: OrderBook 30001, RFQID 30006, BidID 30007, OfferID 30008,
       RLTIndicator 31000, TradingPhase 31001, IPAddress 31002, CertifiedSolution 31003,
       ParPx 32021, LastOptPx 32022, RoutingInstruction 35487, Memo 5149, NoTradeKey 7714.
-->
<fix major="4" minor="4" servicepack="0">

    <header>
        <field name="BeginString" required="Y"/>
        <field name="BodyLength" required="Y"/>
        <field name="MsgType" required="Y"/>
        <field name="SenderCompID" required="Y"/>
        <field name="TargetCompID" required="Y"/>
        <field name="OnBehalfOfCompID" required="N"/>
        <field name="MsgSeqNum" required="Y"/>
        <field name="PossDupFlag" required="N"/>
        <field name="PossResend" required="N"/>
        <field name="SendingTime" required="Y"/>
        <field name="OrigSendingTime" required="N"/>
        <field name="ApplVerID" required="N"/>
    </header>

    <trailer>
        <field name="CheckSum" required="Y"/>
    </trailer>

    <messages>

        <!-- ====================== Administrative ======================= -->

        <message name="Heartbeat" msgtype="0" msgcat="admin">
            <field name="TestReqID" required="N"/>
        </message>

        <message name="TestRequest" msgtype="1" msgcat="admin">
            <field name="TestReqID" required="Y"/>
        </message>

        <message name="ResendRequest" msgtype="2" msgcat="admin">
            <field name="BeginSeqNo" required="Y"/>
            <field name="EndSeqNo" required="Y"/>
        </message>

        <message name="Reject" msgtype="3" msgcat="admin">
            <field name="RefSeqNum" required="Y"/>
            <field name="RefMsgType" required="N"/>
            <field name="RefTagID" required="N"/>
            <field name="SessionRejectReason" required="N"/>
            <field name="Text" required="N"/>
        </message>

        <message name="SequenceReset" msgtype="4" msgcat="admin">
            <field name="NewSeqNo" required="Y"/>
            <field name="GapFillFlag" required="N"/>
        </message>

        <message name="Logout" msgtype="5" msgcat="admin">
            <field name="SessionStatus" required="N"/>
            <field name="Text" required="N"/>
        </message>

        <message name="Logon" msgtype="A" msgcat="admin">
            <field name="EncryptMethod" required="Y"/>
            <field name="HeartBtInt" required="Y"/>
            <field name="ResetSeqNumFlag" required="N"/>
            <field name="Password" required="N"/>
            <field name="NewPassword" required="N"/>
            <field name="SessionStatus" required="N"/>
            <field name="IPAddress" required="Y"/>
            <field name="CertifiedSolution" required="Y"/>
        </message>

        <!-- ======================== Application ======================== -->

        <!--
            The only client initiated application message on the Drop Copy gateway. Used to
            retrieve the current state of all active open orders, for example after a failure.

            The specification table for this message has its PartyID / PartyIDSource /
            PartyRole descriptions shifted by one row. Read as: PartyIDSource is
            D (Proprietary/Custom Code) and PartyRole is 1 (Executing Firm) or
            53 (Trading Mnemonic).
        -->
        <message name="OrderMassStatusRequest" msgtype="AF" msgcat="app">
            <field name="MassStatusReqID" required="Y"/>
            <field name="MassStatusReqType" required="Y"/>
            <component name="Parties" required="Y"/>
            <field name="SecurityID" required="N"/>
            <field name="SecurityIDSource" required="N"/>
            <field name="MarketSegmentID" required="N"/>
        </message>

        <message name="ExecutionReport" msgtype="8" msgcat="app">
            <field name="ApplID" required="Y"/>
            <field name="ExecID" required="Y"/>
            <field name="ClOrdID" required="Y"/>
            <field name="MDEntryID" required="Y"/>
            <field name="OrigClOrdID" required="N"/>
            <field name="OrderID" required="Y"/>
            <field name="CrossID" required="N"/>
            <field name="CrossType" required="N"/>
            <field name="MultiLegReportingType" required="N"/>
            <field name="SecondaryOrderID" required="N"/>
            <field name="ExecType" required="Y"/>
            <field name="TrdMatchID" required="N"/>
            <field name="ExecRefID" required="N"/>
            <field name="ExecRestatementReason" required="N"/>
            <field name="OrdStatus" required="Y"/>
            <field name="WorkingIndicator" required="N"/>
            <field name="OrdRejReason" required="N"/>
            <field name="Text" required="N"/>
            <field name="LastQty" required="N"/>
            <field name="LastPx" required="N"/>
            <field name="LastParPx" required="N"/>
            <field name="LeavesQty" required="Y"/>
            <field name="CumQty" required="Y"/>
            <field name="AvgPx" required="N"/>
            <field name="Symbol" required="Y"/>
            <field name="SecurityID" required="Y"/>
            <field name="SecurityIDSource" required="Y"/>
            <field name="ParPx" required="N"/>
            <component name="Parties" required="N"/>
            <field name="Account" required="N"/>
            <field name="OrdType" required="Y"/>
            <field name="TimeInForce" required="N"/>
            <field name="ExpireTime" required="N"/>
            <field name="ExecInst" required="N"/>
            <field name="Side" required="Y"/>
            <field name="OrderQty" required="Y"/>
            <field name="MaxFloor" required="N"/>
            <field name="DisplayQty" required="N"/>
            <field name="DisplayMethod" required="N"/>
            <field name="Price" required="N"/>
            <field name="StopPx" required="N"/>
            <field name="PreTradeAnonymity" required="N"/>
            <field name="TransactTime" required="Y"/>
            <field name="OrderBook" required="Y"/>
            <field name="LastOptPx" required="N"/>
            <field name="Volatility" required="N"/>
            <field name="LastMkt" required="N"/>
            <field name="AggressorIndicator" required="N"/>
            <field name="NoTradeKey" required="N"/>
            <field name="RoutingInstruction" required="N"/>
            <field name="Memo" required="N"/>
            <field name="TradingPhase" required="N"/>
            <field name="RLTIndicator" required="N"/>
        </message>

        <message name="OrderCancelReject" msgtype="9" msgcat="app">
            <field name="ApplID" required="Y"/>
            <field name="ClOrdID" required="Y"/>
            <field name="OrigClOrdID" required="N"/>
            <field name="OrderID" required="Y"/>
            <component name="Parties" required="N"/>
            <field name="OrdStatus" required="Y"/>
            <field name="CxlRejResponseTo" required="Y"/>
            <field name="CxlRejReason" required="Y"/>
            <field name="Text" required="N"/>
            <field name="TransactTime" required="Y"/>
            <field name="OrderBook" required="N"/>
            <field name="Memo" required="N"/>
        </message>

        <message name="BusinessMessageReject" msgtype="j" msgcat="app">
            <field name="BusinessRejectRefID" required="N"/>
            <field name="RefSeqNum" required="Y"/>
            <field name="RefMsgType" required="Y"/>
            <field name="RefTagID" required="N"/>
            <field name="BusinessRejectReason" required="Y"/>
            <field name="Text" required="N"/>
        </message>

        <message name="MassQuoteAcknowledgement" msgtype="b" msgcat="app">
            <field name="ApplID" required="N"/>
            <field name="QuoteID" required="Y"/>
            <component name="Parties" required="N"/>
            <field name="QuoteCancelType" required="N"/>
            <field name="QuoteStatus" required="Y"/>
            <field name="QuoteRejectReason" required="N"/>
            <field name="Text" required="N"/>
            <field name="OrderBook" required="Y"/>
            <field name="PreTradeAnonymity" required="N"/>
            <field name="TransactTime" required="Y"/>
            <field name="Account" required="N"/>
            <group name="NoQuoteSets" required="N">
                <field name="QuoteSetID" required="N"/>
                <group name="NoQuoteEntries" required="N">
                    <field name="QuoteEntryID" required="N"/>
                    <field name="SecurityID" required="N"/>
                    <field name="SecurityIDSource" required="N"/>
                    <field name="QuoteEntryStatus" required="N"/>
                    <field name="QuoteEntryRejectReason" required="N"/>
                    <field name="BidID" required="N"/>
                    <field name="OfferID" required="N"/>
                    <field name="BidPx" required="N"/>
                    <field name="OfferPx" required="N"/>
                    <field name="BidSize" required="N"/>
                    <field name="OfferSize" required="N"/>
                </group>
            </group>
            <field name="Memo" required="N"/>
            <!--
                The specification table prints tag "310001" for Trading Phase on this message.
                Tag 31001 is used for the same TradingPhase semantic on Execution Report, and
                310001 exceeds the practical custom tag range, so it is treated as a typo for
                31001. Confirm with A5X before relying on this in production.
            -->
            <field name="TradingPhase" required="N"/>
        </message>

        <message name="QuoteStatusReport" msgtype="AI" msgcat="app">
            <field name="ApplID" required="N"/>
            <field name="QuoteMsgID" required="N"/>
            <field name="QuoteReqID" required="N"/>
            <field name="RFQID" required="N"/>
            <component name="Parties" required="N"/>
            <field name="SecurityID" required="N"/>
            <field name="SecurityIDSource" required="N"/>
            <field name="BidID" required="N"/>
            <field name="OfferID" required="N"/>
            <field name="Account" required="N"/>
            <field name="QuoteCancelType" required="N"/>
            <field name="QuoteStatus" required="Y"/>
            <field name="QuoteRejectReason" required="N"/>
            <field name="Text" required="N"/>
            <field name="PreTradeAnonymity" required="N"/>
            <field name="TransactTime" required="Y"/>
            <field name="OrderBook" required="Y"/>
            <field name="ExpireTime" required="N"/>
            <field name="Memo" required="N"/>
        </message>

        <message name="News" msgtype="B" msgcat="app">
            <field name="ApplID" required="Y"/>
            <field name="OrigTime" required="Y"/>
            <field name="Urgency" required="Y"/>
            <field name="Headline" required="Y"/>
            <group name="NoLinesOfText" required="Y">
                <field name="Text" required="Y"/>
            </group>
            <group name="NoRelatedSym" required="Y">
                <field name="Symbol" required="Y"/>
                <field name="SecurityID" required="Y"/>
                <field name="SecurityIDSource" required="Y"/>
            </group>
            <group name="NoUnderlyings" required="N">
                <field name="UnderlyingSymbol" required="N"/>
                <field name="UnderlyingSecurityID" required="N"/>
                <field name="UnderlyingSecurityIDSource" required="N"/>
            </group>
            <group name="NoRoutingIDs" required="Y">
                <field name="RoutingType" required="Y"/>
                <field name="RoutingID" required="Y"/>
            </group>
        </message>

        <message name="TradingSessionStatus" msgtype="h" msgcat="app">
            <field name="TradingSessionID" required="Y"/>
            <field name="TradSesStatus" required="Y"/>
        </message>

    </messages>

    <components>

        <!--
            Party identification block. Role level requirements are business rules and cannot
            be expressed per message in a QuickFIX dictionary, so PartyRole below carries the
            union of all documented roles.
        -->
        <component name="Parties">
            <group name="NoPartyIDs" required="N">
                <field name="PartyID" required="N"/>
                <field name="PartyIDSource" required="N"/>
                <field name="PartyRole" required="N"/>
            </group>
        </component>

    </components>

    <fields>

        <!-- ===================== Session / header ====================== -->
        <field number="8" name="BeginString" type="STRING"/>
        <field number="9" name="BodyLength" type="LENGTH"/>
        <field number="10" name="CheckSum" type="STRING"/>
        <field number="34" name="MsgSeqNum" type="SEQNUM"/>
        <field number="43" name="PossDupFlag" type="BOOLEAN"/>
        <field number="49" name="SenderCompID" type="STRING"/>
        <field number="52" name="SendingTime" type="UTCTIMESTAMP"/>
        <field number="56" name="TargetCompID" type="STRING"/>
        <field number="97" name="PossResend" type="BOOLEAN"/>
        <field number="115" name="OnBehalfOfCompID" type="STRING"/>
        <field number="122" name="OrigSendingTime" type="UTCTIMESTAMP"/>
        <field number="1128" name="ApplVerID" type="STRING"/>

        <field number="35" name="MsgType" type="STRING">
            <value enum="0" description="HEARTBEAT"/>
            <value enum="1" description="TEST_REQUEST"/>
            <value enum="2" description="RESEND_REQUEST"/>
            <value enum="3" description="REJECT"/>
            <value enum="4" description="SEQUENCE_RESET"/>
            <value enum="5" description="LOGOUT"/>
            <value enum="8" description="EXECUTION_REPORT"/>
            <value enum="9" description="ORDER_CANCEL_REJECT"/>
            <value enum="A" description="LOGON"/>
            <value enum="AF" description="ORDER_MASS_STATUS_REQUEST"/>
            <value enum="AI" description="QUOTE_STATUS_REPORT"/>
            <value enum="B" description="NEWS"/>
            <value enum="b" description="MASS_QUOTE_ACKNOWLEDGEMENT"/>
            <value enum="h" description="TRADING_SESSION_STATUS"/>
            <value enum="j" description="BUSINESS_MESSAGE_REJECT"/>
        </field>

        <!-- ====================== Administrative ======================= -->
        <field number="7" name="BeginSeqNo" type="SEQNUM"/>
        <field number="16" name="EndSeqNo" type="SEQNUM"/>
        <field number="36" name="NewSeqNo" type="SEQNUM"/>
        <field number="45" name="RefSeqNum" type="SEQNUM"/>
        <field number="58" name="Text" type="STRING"/>
        <field number="108" name="HeartBtInt" type="INT"/>
        <field number="112" name="TestReqID" type="STRING"/>
        <field number="123" name="GapFillFlag" type="BOOLEAN"/>
        <field number="141" name="ResetSeqNumFlag" type="BOOLEAN"/>
        <field number="371" name="RefTagID" type="INT"/>
        <field number="372" name="RefMsgType" type="STRING"/>
        <field number="554" name="Password" type="STRING"/>
        <field number="925" name="NewPassword" type="STRING"/>

        <field number="98" name="EncryptMethod" type="INT">
            <value enum="0" description="NONE"/>
        </field>

        <field number="373" name="SessionRejectReason" type="INT">
            <value enum="1" description="REQUIRED_TAG_MISSING"/>
            <value enum="2" description="TAG_NOT_DEFINED_FOR_THIS_MESSAGE_TYPE"/>
            <value enum="4" description="TAG_SPECIFIED_WITHOUT_A_VALUE"/>
            <value enum="5" description="VALUE_IS_INCORRECT"/>
            <value enum="6" description="INCORRECT_DATA_FORMAT_FOR_VALUE"/>
            <value enum="9" description="COMPID_PROBLEM"/>
            <value enum="10" description="SENDINGTIME_ACCURACY_PROBLEM"/>
            <value enum="11" description="INVALID_MSGTYPE"/>
            <value enum="13" description="TAG_APPEARS_MORE_THAN_ONCE"/>
            <value enum="14" description="TAG_SPECIFIED_OUT_OF_REQUIRED_ORDER"/>
            <value enum="15" description="REPEATING_GROUP_FIELDS_OUT_OF_ORDER"/>
            <value enum="16" description="INCORRECT_NUMINGROUP_COUNT_FOR_REPEATING_GROUP"/>
            <value enum="18" description="INVALID_OR_UNSUPPORTED_APPLICATION_VERSION"/>
            <value enum="99" description="OTHER"/>
        </field>

        <field number="1409" name="SessionStatus" type="INT">
            <value enum="0" description="SESSION_ACTIVE"/>
            <value enum="2" description="PASSWORD_DUE_TO_EXPIRE"/>
            <value enum="3" description="NEW_SESSION_PASSWORD_DOES_NOT_COMPLY_WITH_POLICY"/>
            <value enum="4" description="SESSION_LOGOUT_COMPLETE"/>
            <value enum="6" description="ACCOUNT_LOCKED"/>
            <value enum="7" description="LOGONS_ARE_NOT_ALLOWED_AT_THIS_TIME"/>
            <value enum="8" description="PASSWORD_EXPIRED"/>
            <value enum="100" description="OTHER"/>
            <value enum="101" description="LOGOUT_DUE_TO_SESSION_LEVEL_FAILURE"/>
            <value enum="102" description="LOGOUT_BY_MARKET_OPERATIONS"/>
            <value enum="103" description="NOT_CONFIGURED_FOR_SPONSORED_ACCESS"/>
            <value enum="104" description="APPLICATION_NOT_AVAILABLE"/>
        </field>

        <!-- =================== Order identification ==================== -->
        <field number="1" name="Account" type="STRING"/>
        <field number="11" name="ClOrdID" type="STRING"/>
        <field number="17" name="ExecID" type="STRING"/>
        <field number="19" name="ExecRefID" type="STRING"/>
        <field number="37" name="OrderID" type="STRING"/>
        <field number="41" name="OrigClOrdID" type="STRING"/>
        <field number="198" name="SecondaryOrderID" type="STRING"/>
        <field number="278" name="MDEntryID" type="STRING"/>
        <field number="548" name="CrossID" type="STRING"/>
        <field number="880" name="TrdMatchID" type="STRING"/>
        <field number="1180" name="ApplID" type="STRING"/>

        <!-- ==================== Mass status request ==================== -->
        <field number="584" name="MassStatusReqID" type="STRING"/>

        <field number="585" name="MassStatusReqType" type="INT">
            <value enum="1" description="OPEN_ORDERS_FOR_INSTRUMENT_AND_PARTY"/>
            <value enum="8" description="OPEN_ORDERS_FOR_PARTY"/>
            <value enum="100" description="OPEN_ORDERS_FOR_SEGMENT_AND_PARTY"/>
        </field>

        <!-- ======================== Instrument ========================= -->
        <field number="48" name="SecurityID" type="STRING"/>
        <field number="55" name="Symbol" type="STRING"/>
        <field number="305" name="UnderlyingSecurityIDSource" type="STRING"/>
        <field number="309" name="UnderlyingSecurityID" type="STRING"/>
        <field number="311" name="UnderlyingSymbol" type="STRING"/>
        <field number="1300" name="MarketSegmentID" type="STRING"/>

        <field number="22" name="SecurityIDSource" type="STRING">
            <value enum="8" description="EXCHANGE_SYMBOL"/>
