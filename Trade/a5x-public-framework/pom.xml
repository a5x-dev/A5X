<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>br.com.a5x.trd</groupId>
	<artifactId>a5x-public-framework</artifactId>
	<version>2.0.0</version>
	<packaging>pom</packaging>
	<name>a5x-public-framework</name>

	<organization>
		<name>A5X</name>
		<url>https://a5x.com.br/</url>
	</organization>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.target>21</maven.compiler.target>
		<maven.compiler.source>21</maven.compiler.source>
		<maven.compiler.release>21</maven.compiler.release>
		<java.version>21</java.version>
	</properties>

	<modules>
		<module>a5x-trading-codegen</module>
		<module>a5x-trading-mitch</module>
		<module>a5x-trading-native</module>
	</modules>

	<scm>
		<developerConnection>scm:git:https://github.com/a5x-dev/A5X.git</developerConnection>
	</scm>

	<dependencies>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<version>2.17.0</version>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<version>5.13.2</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<!--
		The protocol modules (a5x-trading-mitch, a5x-trading-native) do not keep a copy of the
		message models: they declare these two plugins and the property a5x.schema, and every
		build generates the models from the schema of the current version
		(a5x-trading-codegen/src/main/resources) into target/generated-sources/a5x/java.
	-->
	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>exec-maven-plugin</artifactId>
					<version>3.5.0</version>
					<executions>
						<execution>
							<id>generate-models</id>
							<phase>generate-sources</phase>
							<goals>
								<goal>java</goal>
							</goals>
							<configuration>
								<mainClass>br.com.a5x.trd.codegen.A5XCodeGenApp</mainClass>
								<arguments>
									<argument>/${a5x.schema}</argument>
									<argument>${project.build.directory}/generated-sources/a5x</argument>
									<argument>java</argument>
								</arguments>
								<classpathScope>compile</classpathScope>
								<blockSystemExit>true</blockSystemExit>
							</configuration>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>build-helper-maven-plugin</artifactId>
					<version>3.6.0</version>
					<executions>
						<execution>
							<id>add-generated-models</id>
							<phase>generate-sources</phase>
							<goals>
								<goal>add-source</goal>
							</goals>
							<configuration>
								<sources>
									<source>${project.build.directory}/generated-sources/a5x/java</source>
								</sources>
							</configuration>
						</execution>
					</executions>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>
</project>