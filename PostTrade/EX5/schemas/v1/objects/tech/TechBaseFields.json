    "reportName" : {
      "type" : "string",
      "description" : "Name of the report",
      "examples" : [ "EX5F-COL-MRG-0101", "EX5F-COL-MRG-0102" ]
    },
    "quantityOfRows" : {
      "type" : "integer",
      "description" : "Quantity of rows in the file"
