{
  "$schema" : "http://json-schema.org/draft-07/schema#",
  "$id" : "urn:a5x:ex5:schema:v1:business:MonetaryValue",
  "$metadata" : {
    "domain" : "business",
    "schemaId" : "urn:a5x:ex5:schema:v1:business:MonetaryValue"
  },
  "title" : "MonetaryValue",
  "description" : "Financial value with currency specification",
  "type" : "object",
  "properties" : {
    "amount" : {
      "$ref" : "../../types/SignedDecimalNumber.json",
      "description" : "Monetary amount with up to 6 decimal places (accepts negative values)"
    },
    "currency" : {
      "$ref" : "../../objects/business/ExternalCodeTextList.json",
      "description" : "Currency code in which the amount is denominated",
      "$comment" : "Consult External Code List table ExternalCurrencyCode"
    }
  },
  "required" : [ "amount" ],
  "additionalProperties" : true,
  "examples" : [
    { "amount" : 1000.00 },
    { "amount" : -50000.00, "currency" : "USD" },
    { "amount" : 1000.123456, "currency" : "BRL" }
  ]
}