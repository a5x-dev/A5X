{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:a5x:ex5:schema:v1:business:CollateralRequiredMargin",
  "$metadata": {
    "domain": "business",
    "schemaId": "urn:a5x:ex5:schema:v1:business:CollateralRequiredMargin"
  },
  "title": "Collateral Required Margin",
  "description": "Required margin and collateral balance information for a participant account",
  "type": "object",
  "properties": {
    "participantIdentificationRequester": {
      "$ref": "../../objects/business/PartyId.json",
      "description": "Identification of the participant that requested the required margin information"
    },
    "accountIdentificationRequester": {
      "$ref": "../../objects/business/AccountIdentification.json",
      "description": "Identification of the account that requested the required margin information"
    },
    "participantIdentificationRequested": {
      "$ref": "../../objects/business/PartyId.json",
      "description": "Identification of the participant to which the required margin information refers"
    },
    "accountIdentificationRequested": {
      "$ref": "../../objects/business/AccountIdentification.json",
      "description": "Identification of the account to which the required margin information refers"
    },
    "tradeDate": {
      "type": "string",
      "format": "date",
      "description": "Reference date of the required margin information"
    },
    "collateralCoverageInformation": {
      "$ref": "../../objects/business/CollateralCoverageInformation.json",
      "description": "Collateral coverage information (information type and collateral coverage type)"
    },
    "marginInformation": {
      "type": "object",
      "description": "Margin metrics and resulting collateral balance",
      "properties": {
        "riskWithoutCollateral": {
          "$ref": "../../objects/business/MonetaryValue.json",
          "description": "Risk amount before collateral coverage"
        },
        "initialMargin": {
          "$ref": "../../objects/business/MonetaryValue.json",
          "description": "Initial Margin calculated for Margin Account."
        },
        "theoreticalAdditionalMargin": {
          "$ref": "../../objects/business/MonetaryValue.json",
          "description": "Theoretical additional margin amount"
        },
        "totalTheoreticalMargin": {
          "$ref": "../../objects/business/MonetaryValue.json",
          "description": "Total theoretical margin amount (initial + additional)"
        },
        "contingentVariationMargin": {
          "$ref": "../../objects/business/MonetaryValue.json",
          "description": "Contingent variation margin amount"
        },
        "optionPremiumMargin": {
          "$ref": "../../objects/business/MonetaryValue.json",
          "description": "Option premium margin amount"
        },
        "totalCollateralValue": {
          "$ref": "../../objects/business/MonetaryValue.json",
          "description": "Total value of collateral posted"
        },
        "collateralBalance": {
          "$ref": "../../objects/business/MonetaryValue.json",
          "description": "Resulting collateral balance. Negative values indicate a collateral deficit"
        }
      },
      "required": [
        "riskWithoutCollateral",
        "initialMargin",
        "totalCollateralValue",
        "collateralBalance"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "participantIdentificationRequester",
    "accountIdentificationRequester",
    "participantIdentificationRequested",
    "accountIdentificationRequested",
    "tradeDate",
    "collateralCoverageInformation",
    "marginInformation"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "participantIdentificationRequester": {
        "id": 999,
        "category": 3
      },
      "accountIdentificationRequester": {
        "id": 529876543
      },
      "participantIdentificationRequested": {
        "id": 888,
        "category": 4
      },
      "accountIdentificationRequested": {
        "id": 123456789
      },
      "tradeDate": "2022-05-26",
      "collateralCoverageInformation": {
        "informationType": 2,
        "collateralCoverageType": 1
      },
      "marginInformation": {
        "riskWithoutCollateral": {
          "amount": "2870147502.59"
        },
        "initialMargin": {
          "amount": "300000.00"
        },
        "totalCollateralValue": {
          "amount": "2046500729.22"
        },
        "collateralBalance": {
          "amount": "50000.00"
        }
      }
    }
  ]
}