{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:a5x:ex5:schema:v1:business:CollateralPositionDetail",
  "$metadata": {
    "domain": "business",
    "schemaId": "urn:a5x:ex5:schema:v1:business:CollateralPositionDetail"
  },
  "title": "Collateral Position Detail",
  "description": "Provides collateral identification, financial instrument, quantity and value information for a posted collateral position",
  "type": "object",
  "properties": {
    "collateralCoverageType": {
      "$ref": "../../objects/business/ExternalCodeList.json",
      "description": "Purpose for which the collateral is allocated",
      "$comment": "Consult External Code List table ExternalCollateralCoverageTypeCode"
    },
    "assetNumber": {
      "type": "string",
      "maxLength": 40,
      "minLength": 1,
      "description": "Collateral asset number"
    },
    "holderIndicator": {
      "type": "boolean",
      "description": "Indicates whether the collateral belongs to the identified holder"
    },
    "coverageMarginIndicator": {
      "type": "boolean",
      "description": "Indicates whether the collateral is identified for margin coverage"
    },
    "collateralType": {
      "$ref": "../../objects/business/ExternalCodeList.json",
      "description": "Collateral type code",
      "$comment": "Consult External Code List table ExternalCollateralTypeCode"
    },
    "collateralSubType": {
      "type": "string",
      "maxLength": 35,
      "description": "Additional classification for the collateral"
    },
    "collateralClientCategory": {
      "$ref": "../../objects/business/ExternalCodeList.json",
      "description": "Category of the collateral holder",
      "$comment": "Consult External Code List table ExternalCollateralClientCategoryTypeCode"
    },
    "collateralReference": {
      "type": "string",
      "maxLength": 35,
      "description": "Collateral reference or identification (ticker symbol)"
    },
    "financialInstrumentIdentification": {
      "$ref": "../../objects/business/InstrumentIdentification.json",
      "description": "Identification of the financial instrument"
    },
    "maturityDate": {
      "type": "string",
      "format": "date",
      "description": "Collateral maturity date when applicable"
    },
    "collateralDetailInformation": {
      "$ref": "../../objects/business/CollateralDetailInformation.json",
      "description": "Value and quantity information associated with the collateral position"
    },
    "isin": {
      "$ref": "../../types/Isin.json",
      "description": "International Securities Identification Number - Standardized international code for unique identification of financial instruments"
    },
    "portfolio": {
      "type": "string",
      "maxLength": 10,
      "description": "Collateral portfolio identification"
    }
  },
  "required": [
    "collateralCoverageType",
    "assetNumber",
    "holderIndicator",
    "coverageMarginIndicator",
    "collateralType",
    "collateralReference",
    "financialInstrumentIdentification",
    "collateralDetailInformation"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "collateralCoverageType": 1,
      "assetNumber": "000000202100000173821",
      "holderIndicator": true,
      "coverageMarginIndicator": true,
      "collateralType": 3,
      "collateralSubType": "FEDERAL_BOND",
      "collateralReference": "ABCD",
      "financialInstrumentIdentification": {
        "id": "100000109699",
        "source": "8",
        "exchange": "A5XB"
      },
      "maturityDate": "2025-12-31",
      "collateralDetailInformation": {
        "depositedQuantity": 1000,
        "valuedQuantity": 950,
        "deliveryQuantity": 100,
        "blockedQuantity": 50,
        "collateralValue": {
          "amount": 2870147502.59
        },
        "withdrawalBlockedValue": {
          "amount": 0.00
        }
      },
      "isin": "BREVWZT1PUO6",
      "portfolio": "5590-5"
    },
    {
      "collateralCoverageType": 1,
      "assetNumber": "000000202100000173822",
      "holderIndicator": false,
      "coverageMarginIndicator": true,
      "collateralType": 3,
      "collateralReference": "EFGH",
      "financialInstrumentIdentification": {
        "id": "100000109700",
        "source": "8",
        "exchange": "A5XB"
      },
      "collateralDetailInformation": {
        "depositedQuantity": 500,
        "valuedQuantity": 480,
        "deliveryQuantity": 10,
        "blockedQuantity": 5,
        "collateralValue": {
          "amount": 2222.76
        },
        "withdrawalBlockedValue": {
          "amount": 5000.00
        }
      }
    }
  ]
}