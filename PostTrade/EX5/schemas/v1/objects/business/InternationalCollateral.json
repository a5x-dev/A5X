{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:a5x:ex5:schema:v1:business:InternationalCollateral",
  "$metadata": {
    "domain": "business",
    "schemaId": "urn:a5x:ex5:schema:v1:business:InternationalCollateral"
  },
  "title": "International Guarantees",
  "description": "International guarantee information for account registration",
  "type": "object",
  "properties": {
    "jurisdictionOfOrigin": {
      "$ref": "../../objects/business/ExternalCodeTextList.json",
      "description": "Jurisdiction of origin",
      "$comment": "Consult External Code List table ExternalCountryCode"
    },
    "legalForm": {
      "$ref": "../../objects/business/ExternalCodeList.json",
      "description": "Legal entity formation type (optional)",
      "$comment": "Consult External Code Text List table ExternalNonResidentLegalStructure."
    },
    "beneficiaryBankDetails": {
      "$ref": "../../objects/business/BankingDetails.json",
      "description": "Beneficiary bank details"
    },
    "transferCurrency": {
      "$ref": "../../objects/business/ExternalCodeTextList.json",
      "description": "Transfer currency",
      "$comment": "Consult External Code List table ExternalCurrencyCode"
    },
    "intermediaryBankDetails": {
      "$ref": "../../objects/business/BankingDetails.json",
      "description": "Intermediary bank details (optional)"
    }
  },
  "required": [
    "jurisdictionOfOrigin"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "jurisdictionOfOrigin": "USA",
      "legalForm": 1,
      "beneficiaryBankDetails": {
        "accountNumber": "DE89370400440532013000",
        "iban": "DE89370400440532013000",
        "swiftCode": "DXXXXXXF",
        "bankName": "Banco do XPTO S.A.",
        "bankCountry": "BRA"
      },
      "transferCurrency": "USD",
      "intermediaryBankDetails": {
        "accountNumber": "DE89370400440532013000",
        "iban": "DE89370400440532013000",
        "swiftCode": "DXXXXXXF",
        "bankName": "Banco do XPTO S.A.",
        "bankCountry": "BRA"
      }
    }
  ]
}