{
  "$schema" : "http://json-schema.org/draft-07/schema#",
  "$id" : "urn:a5x:ex5:schema:v1:position:ex5-pos-dtl-0101",
  "$metadata" : {
    "domain" : "position",
    "schemaId" : "urn:a5x:ex5:schema:v1:position:ex5-pos-dtl-0101"
  },
  "title" : "Position Report Request",
  "description" : "Message for position Report Request",
  "type" : "object",
  "properties" : {
    "clearingMemberIdentification" : {
      "$ref" : "../../objects/business/PartyId.json",
      "description" : "Provides details about the clearing member identification"
    },
    "participantIdentification" : {
      "$ref" : "../../objects/business/PartyId.json",
      "description" : "Provides details about the origin participant identification"
    },
    "accountIdentification" : {
      "type" : "array",
      "items" : {
        "$ref" : "../../objects/business/AccountIdentification.json",
        "description" : "Accounts"
      },
      "minItems" : 1,
      "maxItems" : 60,
      "description" : "Accounts whose positions are requested (1 to 60 accounts per request)"
    },
    "financialInstruments" : {
      "type" : "array",
      "items" : {
        "$ref" : "../../objects/business/InstrumentIdentification.json"
      },
      "minItems" : 1,
      "description" : "Array of financial instruments. When omitted, the report includes all instruments of the requested accounts"
    },
    "reportType" : {
      "$ref" : "../../objects/business/ExternalCodeList.json",
      "description" : "Type of report being requested",
      "$comment" : "Consult External Code List table ExternalReportTypeCode.",
      "examples" : [ 1, 2 ]
    }
  },
  "required" : [ "participantIdentification", "accountIdentification", "reportType" ],
  "additionalProperties" : false,
  "examples" : [ {
    "clearingMemberIdentification" : {
      "id" : 999,
      "category" : 2
    },
    "participantIdentification" : {
      "id" : 789012,
      "category" : 3
    },
    "accountIdentification" : [ {
      "id" : 529876543
    }, {
      "id" : 529876544
    } ],
    "reportType" : 1
  }, {
    "participantIdentification" : {
      "id" : 789012,
      "category" : 3
    },
    "accountIdentification" : [ {
      "id" : 529876543
    } ],
    "financialInstruments" : [ {
      "id" : "100000000000001",
      "source" : "8",
      "exchange" : "A5XB"
    }, {
      "id" : "100000000000002",
      "source" : "8",
      "exchange" : "A5XB"
    } ],
    "reportType" : 1
  } ]
}
