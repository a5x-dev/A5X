{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:a5x:ex5:schema:v1:capture_and_allocation:ex5-trd-agg-01",
  "$metadata": {
    "domain": "capture_and_allocation",
    "schemaId": "urn:a5x:ex5:schema:v1:capture_and_allocation:ex5-trd-agg-01"
  },
  "title": "CompressionTrade",
  "$comment": "The example uses the CERT block BL1SBR4S8Y51cboW8A (10 constituents) and lists only its first two.",
  "description": "Compression Trade. Lists the trades compressed into a block. The block itself (account, participant, instrument, quantities) is notified by the ex5-trd-ntf-0301 of the same block; trade.tradeIdentification and trade.allocationIdentification link the two messages. compressionGroup.compressionGroupIdentification carries the External Trade ID of the block.",
  "type": "object",
  "properties": {
    "trade": {
      "$ref": "../../objects/business/CompressionTradeIdentification.json",
      "description": "Keys of the compressed trade (the block)"
    },
    "compressionGroup": {
      "$ref": "../../objects/business/CompressionGroup.json",
      "description": "Compression group information"
    },
    "noCompressionGroup": {
      "type" : "array",
      "items" : {
          "$ref": "../../objects/business/NoCompressionGroup.json"
      },
      "minItems" : 1,
      "maxItems" : 200,
      "description": "Trades compressed into the block. Up to 200, the Block Size agreed for Day 1: a larger block is not sent as a Compression Trade"
    },
    "pagination": {
      "$ref": "../../objects/tech/Pagination.json"
    }
  },
  "required": [
    "trade",
    "compressionGroup",
    "noCompressionGroup"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "trade": {
        "tradeIdentification": "3HBHYTHO5NL000",
        "allocationIdentification": "BL1SBR4S8Y51cboW8A"
      },
      "compressionGroup": {
        "compressionGroupIdentification": "3HBHYTHO5NL000",
        "compressionGroupStatus": 1,
        "compressionGroupDatetime": "2026-09-01T17:15:52Z"
      },
      "noCompressionGroup": [
        {
          "orderIdentification": "295852",
          "tradeIdentification": "TRidkURb65",
          "allocationIdentification": "AB1SBR4S8Y51cboW8",
          "transactionDateTime": "2026-09-01T17:15:44Z",
          "tradeQuantity": "100",
          "compressionTradeStatusCode": 1
        },
        {
          "tradeIdentification": "TRidkURb66",
          "allocationIdentification": "AB1SBR4S8Y51cboW9",
          "transactionDateTime": "2026-09-01T17:15:44Z",
          "tradeQuantity": "100",
          "compressionTradeStatusCode": 1
        }
      ]
    }
  ]
}
