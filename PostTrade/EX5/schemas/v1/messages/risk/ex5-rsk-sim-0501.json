{
  "$schema" : "http://json-schema.org/draft-07/schema#",
  "$id" : "urn:a5x:ex5:schema:v1:risk:ex5-rsk-sim-05",
  "$metadata" : {
    "domain" : "risk",
    "schemaId" : "urn:a5x:ex5:schema:v1:risk:ex5-rsk-sim-05"
  },
  "title": "Risk Simulation Result",
  "description": "Message for a single Risk Simulation Result",
  "type": "object",
  "properties": {
    "currency": {
      "$ref": "../../objects/business/ExternalCodeTextList.json",
      "description": "Currency applied to every monetary value."
    },
    "clearingMemberIdentification": {
      "$ref": "../../objects/business/PartyId.json",
      "description": "Provides details about the clearing member identification"
    },
    "participantIdentification": {
      "$ref": "../../objects/business/PartyId.json",
      "description": "Provides details about the participant identification"
    },
    "accountIdentification": {
      "$ref": "../../objects/business/AccountIdentification.json",
      "description": "Provides details about the account identification"
    },
    "riskSimulationDetails": {
      "$ref": "../../objects/business/RiskSimulationDetails.json",
      "description": "Collateral coverage information details of the simulation result"
    }
  },
  "required": [
    "clearingMemberIdentification",
    "participantIdentification",
    "accountIdentification",
    "riskSimulationDetails"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "currency": "BRL",
      "clearingMemberIdentification": {
        "id": 123456,
        "category": 2
      },
      "participantIdentification": {
        "id": 789012,
        "category": 3
      },
      "accountIdentification": {
        "id": 1234
      },
      "riskSimulationDetails": {
        "riskSimulationId": "Simulation123",
        "timestamp": "2025-10-02T12:34:56Z",
        "totalLiability": 500000.00,
        "initialMargin": 100000.25,
        "contingentVariationMargin": 75000.50,
        "netLiquidatingValue": 200000.75,
        "netCollateral": 180000.00,
        "liquidityConcentrationRiskMargin": 50000.00,
        "wrongWayRiskMargin": 25000.25,
        "systemStatusMessage": "Simulation Successful. Excluded Instrument(s): XXXX",
        "userComment": "Result under base scenario; revise foreign exchange exposure"
      }
    }
  ]
}