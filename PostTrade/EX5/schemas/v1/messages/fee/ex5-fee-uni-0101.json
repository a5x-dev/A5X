        "documentIdentifier": {
          "documentType": 2,
          "documentNumber": "12345678909"
        }
      },
      "groupIdentification": "GRP000123",
      "feeParameter": {
        "feeProductGroup": 5,
        "feeComponent": 3,
        "feeType": 1,
        "makerTaker": 2,
        "tradeMode": 2,
        "investorType": 3,
        "feeTier": 1
      },
      "unitCostPercentage": 0.0025
    },
    {
      "referenceDate": "2026-10-27T00:00:00Z",
