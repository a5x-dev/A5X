{
  "$schema" : "http://json-schema.org/draft-07/schema#",
  "$id" : "urn:a5x:ex5:schema:v1:fee:ex5-fee-uni-01",
  "$metadata" : {
    "domain" : "fee",
    "schemaId" : "urn:a5x:ex5:schema:v1:fee:ex5-fee-uni-01"
  },
  "title" : "Fee Unit Cost Intraday",
  "description" : "Intraday message with the unit cost of the document for a new account identified during the daily registry query",
  "type" : "object",
  "properties" : {
    "referenceDate" : {
      "$ref" : "../../types/ISODateTime.json",
      "description" : "Reference date of the information"
    },
    "messageTimestamp" : {
      "$ref" : "../../types/ISODateTime.json",
      "description" : "Message generation timestamp"
    },
    "participantIdentification" : {
      "$ref" : "../../objects/business/PartyId.json",
      "description" : "Participant where the account was opened",
      "$metadata" : {
        "destinationParty" : true
      }
    },
    "accountIdentification" : {
      "$ref" : "../../objects/business/FeeAccountIdentification.json",
      "description" : "Account identification, with document and opening date"
    },
    "groupIdentification" : {
      "type" : "string",
      "minLength" : 1,
      "maxLength" : 9,
      "description" : "Identification of the parameterized fund management or treasury group"
    },
    "feeParameter" : {
      "$ref" : "../../objects/business/FeeParameter.json",
      "description" : "Fee calculation parameters"
    },
    "unitCostPercentage" : {
      "type" : "number",
      "minimum" : 0,
      "maximum" : 100,
      "multipleOf" : 0.000001,
      "description" : "Unit cost value in percentage"
    },
    "financialUnitCost" : {
      "type" : "number",
      "minimum" : 0,
      "maximum" : 999999999.999999,
      "multipleOf" : 0.000001,
      "description" : "Unit cost value in financial terms"
    }
  },
  "required" : [ "referenceDate", "messageTimestamp", "participantIdentification", "accountIdentification", "feeParameter" ],
  "anyOf" : [ {
    "required" : [ "unitCostPercentage" ]
  }, {
    "required" : [ "financialUnitCost" ]
  } ],
  "additionalProperties" : false,
  "examples": [
    {
      "referenceDate": "2026-10-27T00:00:00Z",
      "messageTimestamp": "2026-10-27T14:35:12.418Z",
      "participantIdentification": {
        "id": 123456,
        "category": 3
      },
      "accountIdentification": {
        "id": 529876543,
