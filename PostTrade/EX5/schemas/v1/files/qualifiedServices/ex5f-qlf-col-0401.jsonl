    "domain": "qualifiedServices",
    "schemaId": "urn:a5x:ex5:schema:v1:qualifiedServices:ex5f-qlf-col-04"
  },
  "title": "Collateral Administration File",
  "description": "Consolidated collateral administration file containing posted collateral, collateral portfolio details at custodians and required margin information (QUALIF004)",
  "type": "object",
  "properties": {
    "participantIdentificationRequester": {
      "$ref": "../../objects/business/PartyId.json",
      "description": "Identification of the participant requesting the information"
    },
    "accountIdentificationRequester": {
      "$ref": "../../objects/business/AccountIdentification.json",
      "description": "Identification of the requester account"
    },
    "participantIdentificationRequested": {
      "$ref": "../../objects/business/PartyId.json",
      "description": "Identification of the participant for which the information was requested"
    },
    "accountIdentificationRequested": {
      "$ref": "../../objects/business/AccountIdentification.json",
      "description": "Identification of the requested account"
    },
    "postedCollateral": {
      "type": "array",
      "items": {
        "$ref": "../../objects/business/CollateralPositionDetail.json"
      },
      "minItems": 0,
      "maxItems": 10000,
      "description": "Posted collateral details for the participant and account"
    },
    "collateralPortfolioDetailsAtCustodians": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "../../objects/business/CollateralPositionDetail.json"
          },
          {
            "properties": {
              "settlementParticipantIdentification": {
                "$ref": "../../objects/business/PartyId.json",
                "description": "Identification of the full trading participant or settlement participant related to the collateral"
              },
              "settlementAccountIdentification": {
                "$ref": "../../objects/business/AccountIdentification.json",
                "description": "Investor or account identification at the full trading or settlement participant"
              }
            }
          }
        ]
      },
      "minItems": 0,
      "maxItems": 10000,
      "description": "Collateral portfolio details held at custodians"
    },
    "requiredMargin": {
      "type": "array",
      "items": {
        "$ref": "../../objects/business/CollateralRequiredMargin.json"
      },
      "minItems": 0,
      "maxItems": 10000,
      "description": "Required margin information"
    }
  },
  "required": [
    "participantIdentificationRequester",
    "participantIdentificationRequested"
  ],
  "additionalProperties": false,
