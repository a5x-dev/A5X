{
  "$schema" : "http://json-schema.org/draft-07/schema#",
  "$id" : "urn:a5x:ex5:schema:v1:positions:ex5f-pos-evt-0201",
  "$metadata" : {
    "domain" : "positions",
    "schemaId" : "urn:a5x:ex5:schema:v1:positions:ex5f-pos-evt-0201"
  },
  "title" : "CorporateActionPositionReport File Schema",
  "description" : "CorporateActionPositionReport File Schema",
  "type" : "object",
  "properties" : {
    "referenceDate" : {
      "type" : "string",
      "format" : "date-time",
      "description" : "Reference date of the information"
    },
    "tickerSymbol" : {
      "type" : "string",
      "minLength" : 1,
      "maxLength" : 35,
      "description" : "Ticker symbol that identifies stocks traded on stock exchange"
    },
    "financialInstrumentIdentificationId" : {
      "type" : "string",
      "minLength" : 1,
      "maxLength" : 35,
      "description" : "Proprietary identification of an instrument"
    },
    "financialInstrumentIdentificationSource" : {
      "type" : "string",
      "minLength" : 1,
      "maxLength" : 35,
      "description" : "Source of the instrument identification"
    },
    "financialInstrumentIdentificationExchange" : {
      "type" : "string",
      "minLength" : 3,
      "maxLength" : 20,
      "description" : "Identifier code of the exchange where the instrument is listed"
    },
    "underlyingInstrumentIdentificationId" : {
      "type" : "string",
      "minLength" : 1,
      "maxLength" : 35,
      "description" : "Underlying instrument identifier"
    },
    "underlyingInstrumentIdentificationSource" : {
      "type" : "string",
      "minLength" : 1,
      "maxLength" : 35,
      "description" : "Source of the instrument identification"
    },
    "underlyingInstrumentIdentificationExchange" : {
      "type" : "string",
      "minLength" : 3,
      "maxLength" : 20,
      "description" : "Identifier code of the exchange where the instrument is listed"
    },
    "underlyingISIN" : {
      "type" : "string",
      "maxLength" : 12,
      "pattern" : "^BR[A-Z0-9]{4}[A-Z0-9]{3}[A-Z0-9]{2}\\d$",
      "description" : "ISIN of the underlying instrument"
    },
    "eventStatus" : {
      "type" : "integer",
      "minimum" : 0,
      "maximum" : 999999,
      "description" : "Event status code",
      "$comment" : "Consult External Code List table ExternalCorporateActionStatusCode"
    },
    "corporateActionIdentification" : {
      "type" : "integer",
      "minimum" : 0,
      "maximum" : 999999,
      "description" : "Corporate action event identification",
      "$comment" : "Consult External Code List table ExternalCorporateActionCode"
    },
    "corporateActionType" : {
      "type" : "string", 
      "maxLength" : 15, 
      "minLength" : 1, 
      "description" : "Corporate action type classification",
      "$comment" : "Consult External Code List table ExternalCorporateActionsTypeCode"
    },
    "voluntaryIndicator" : {
      "type" : "boolean",
      "description" : "Indicates whether the event is voluntary or involuntary"
    },
    "recordDate" : {
      "type" : "string",
      "format" : "date-time",
      "description" : "Record date - date with rights to the corporate action"
    },
    "exDate" : {
      "type" : "string",
      "format" : "date-time",
      "description" : "Ex-date - date without rights to the corporate action"
    },
    "effectiveDate" : {
      "type" : "string",
      "format" : "date-time",
      "description" : "Effective date of the corporate action"
    },
    "paymentDate" : {
      "type" : "string",
      "format" : "date-time",
      "description" : "Payment date of the corporate action"
    },
    "eventCalculationType" : {
      "type" : "integer",
      "minimum" : 0,
      "maximum" : 999999,
      "description" : "Indicates the calculation type applied to the event (factor or percentage)",
      "$comment" : "Consult External Code List table ExternalEventCalculationTypeCode"
    },
    "eventCalculationMethod" : {
      "type" : "integer",
      "minimum" : 0,
      "maximum" : 999999,
      "description" : "Indicates the calculation method applied to the event",
      "$comment" : "Consult External Code List table ExternalEventCalculationMethodTypeCode"
    },
    "eventPrice" : {
      "type" : "string",
      "minLength" : 1,
      "maxLength" : 20,
      "pattern" : "^\\d{1,15}(\\.\\d{1,2})?$",
      "description" : "Event financial value"
    },
    "eventPercentage" : {
      "type" : "string",
      "description" : "Event percentage"
    },
    "eventFactor" : {
      "type" : "number",
      "description" : "Event factor"
    },
    "externalEventIdentification" : {
      "type" : "string",
      "minLength" : 1,
      "maxLength" : 35,
      "description" : "Exchange process ID corresponding to the event on the underlying asset"
    },
    "taxIndicator" : {
      "type" : "boolean",
      "description" : "Indicates whether the event will be taxed"
    },
    "afterApplyingCorporateActionsIsin" : {
      "type" : "string",
      "maxLength" : 12,
      "pattern" : "^BR[A-Z0-9]{4}[A-Z0-9]{3}[A-Z0-9]{2}\\d$",
      "description" : "ISIN after applying the corporate action"
    },
    "afterApplyingCorporateActionsTickerSymbol" : {
      "type" : "string",
      "minLength" : 1,
      "maxLength" : 35,
      "description" : "Ticker symbol after applying the corporate action"
    },
    "afterApplyingCorporateActionsUnderlyingIsin" : {
      "type" : "string",
      "maxLength" : 12,
      "pattern" : "^BR[A-Z0-9]{4}[A-Z0-9]{3}[A-Z0-9]{2}\\d$",
      "description" : "Underlying asset ISIN after applying the corporate action"
    },
    "beforeApplyingCorporateActionsIsin" : {
      "type" : "string",
      "maxLength" : 12,
      "pattern" : "^BR[A-Z0-9]{4}[A-Z0-9]{3}[A-Z0-9]{2}\\d$",
      "description" : "ISIN before the corporate action"
    },
    "beforeApplyingCorporateActionsTickerSymbol" : {
      "type" : "string",
      "minLength" : 1,
      "maxLength" : 35,
      "description" : "Ticker symbol before the corporate action"
    },
    "beforeApplyingCorporateActionsUnderlyingIsin" : {
      "type" : "string",
      "maxLength" : 12,
      "pattern" : "^BR[A-Z0-9]{4}[A-Z0-9]{3}[A-Z0-9]{2}\\d$",
      "description" : "Underlying asset ISIN before the corporate action"
    }
  },
  "required" : [
    "referenceDate",
    "tickerSymbol",
    "financialInstrumentIdentificationId",
    "financialInstrumentIdentificationSource",
    "financialInstrumentIdentificationExchange",
    "underlyingInstrumentIdentificationId",
    "underlyingInstrumentIdentificationSource",
    "underlyingInstrumentIdentificationExchange",
    "eventStatus",
    "corporateActionIdentification",
    "corporateActionType",
    "voluntaryIndicator",
    "recordDate",
    "exDate",
    "effectiveDate",
    "eventCalculationType",
    "eventCalculationMethod",
    "externalEventIdentification",
    "taxIndicator"
  ],
  "additionalProperties" : false
}
