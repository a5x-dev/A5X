{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:a5x:ex5:schema:v1:settlement:ex5f-stl-ntf-0101",
  "$metadata": {
    "domain": "settlement",
    "schemaId": "urn:a5x:ex5:schema:v1:settlement:ex5f-stl-ntf-0101"
  },
  "title": "CashEntryType",
  "description": "Cash entry information",
  "type": "object",
  "properties": {
    "referenceDate": {
      "type": "string",
      "format": "date",
      "description": "Reference date of the information"
    },
    "clearingBrazilianPaymentSystem": {
      "type": "string",
      "description": "Clearing code in the Brazilian Payment System (SPB)",
      "minLength": 1,
      "maxLength": 35
    },
    "clearingIdentification": {
      "type": "string",
      "description": "Clearing identification",
      "minLength": 1,
      "maxLength": 35
    },
    "cashEntryTypeCode": {
      "type": "integer",
      "description": "Cash entry type code"
    },
    "cashEntryTypeName": {
      "type": "string",
      "description": "Name of the cash entry type code",
      "minLength": 1,
      "maxLength": 120
    },
    "creditDebitIndicator": {
      "type": "string",
      "description": "Indicates whether the cash entry is a credit or a debit",
      "minLength": 1,
      "maxLength": 35
    },
    "movementTypeCode": {
      "type": "integer",
      "description": "Identifies the code of the movement type"
    },
    "movementTypeName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "description": "Name of the movement type code"
    },
    "reversalIndicator": {
      "type": "boolean",
      "description": "Indicates whether the cash entry is a reversal"
    },
    "reversalIdentification": {
      "type": "integer",
      "description": "Identifies the reversal cash entry"
    }
  },
  "required": ["referenceDate", "clearingBrazilianPaymentSystem", "clearingIdentification", "cashEntryTypeCode", "cashEntryTypeName", "creditDebitIndicator"],
  "additionalProperties": false
}
